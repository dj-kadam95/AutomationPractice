package assignments_072_90;

public class Assignment_84 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub

//		WAP on String functions using replace, replaceAll; substring
//		matches, repeat

		String s = "Dhananjay Kadam";
		System.out.println(s);

		String s1 = s.replace("Kadam", "Deshmukh");
		System.out.println("replace : "+s1);
		
		String s2 = s.replaceAll("D(.*)","Yogesh Kadam");
		System.out.println("replaceAll : "+s2);
		
		String s3 = s.substring(10,15);
		System.out.println("substring : "+s3);
		
		boolean b = s.matches("K(.*)");
		System.out.println("matches Kadam :"+b);
		
		String s4 = s.repeat(3);
		System.out.println("repeat : "+s4);
	}

}
