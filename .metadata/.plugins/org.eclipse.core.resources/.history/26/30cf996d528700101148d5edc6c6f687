import java.util.Arrays;

public class Assignment_82 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub

//		WAP to copy one array into another array in reverse order
		
		int[] str1 =new int[4];
		
		str1[0]=11;
		str1[1]=17;
		str1[2]=10;
		str1[3]=8;
		
		int[] str2 =new int[4];
		
		str2[3]=8;
		str2[2]=17;
		str2[1]=8;
		str2[0]=10;
		
		Arrays.sort(str1);
		Arrays.sort(str2);
		
		String s1 =Arrays.toString(str1);
		
		System.out.println("\nstr1 : "+s1);
		
		String s2 =Arrays.toString(str1);
	
		System.out.println("\nstr2 : "+s2);
		
		boolean b =s1.equals(s2);
		System.out.println(b);	
		
		if((str1.length)==(str2.length)) {
			
			System.out.println("anagram by length");
			if (b == true) {
				System.out.println("anagram by sort");
			}
		} else {
			System.out.println("not anagram");
		
		}
	
	}

}
