package apr11__18_collection;

import java.util.ArrayList;
import java.util.Collection;
import java.util.Iterator;
import java.util.List;
import java.util.ListIterator;

public class A16_A_list_methods {

	public static void main(String[] args) {
		// TODO Auto-generated method stub

		List<String> c1 = new ArrayList<>();// upcasting

		c1.add("DJ");
		c1.add("Vaishnavi");
		c1.add("Harsha");
		System.out.println(c1);

//			addAll method

		Collection<String> c2 = new ArrayList<>();
		c2.addAll(c1);
		System.out.println(c2);
		c2.add("Yogesh");
		System.out.println(c2);

//			contains method		

		boolean b1 = c2.contains("vishal");
		System.out.println(b1);
		boolean b2 = c2.containsAll(c1);
		System.out.println(b2);
		boolean b3 = c1.containsAll(c2);
		System.out.println(b3);

//			remove

		c2.remove("Yogesh");
		c2.add("Sarita");
		System.out.println(c2);

//			removeAll

		c2.add("Yogesh");
		c2.removeAll(c1);
		System.out.println(c2);

//	     isEmpty

		boolean b4 = c2.isEmpty();
		System.out.println(" " + b4);

//			clear

		c2.clear();
		System.out.println(c2);
		boolean b8 = c2.isEmpty();
		System.out.println(" " + b8);

//			equals

		boolean b5 = c2.equals(c1);
		System.out.println(b5);

//			ListIterator

		ListIterator<String> b = c1.listIterator();

//			listIterator is one the methopd from interface
//			called ListIterator & interface consist only abstract methods

		boolean b6 = b.hasNext();
		System.out.println(b6);

		while (b.hasNext() == true) {
			String d = b.next();
			System.out.println(d + " forword");

		}

		System.out.println("");

		while (b.hasPrevious() == true) {
			String d = b.previous();
			System.out.println(d + " backword");

		}

//			Iterator

		Iterator<String> a = c1.iterator();
		boolean b7 = a.hasNext();
		System.out.println(b7);
//			int b =a.next();
//			int c =a.next();
//			System.out.println(c+b);

		while (a.hasNext() == true) {
			String d = a.next();
			System.out.println(d);

		}
//			
//	     size

		int d = c1.size();
		System.out.println(d);

	}

}
