		String[] str1 =new String[length];
		String[] str2 =new String[length];
		
		for(int i =0; i<length; i++) {
			
			System.out.print("enter a string value : "+str1[i]+" :");
			str1[i] = sc.next();
			System.out.print("enter a string value : ");
			str2[i] = sc.next();
		     
	
		}		
		System.out.println("\n"+Arrays.toString(str1));
		System.out.println("\n"+Arrays.toString(str2));
		
		if(str2.equals(str1)) {	
			System.out.print("both the arrays are same");			
		}else {		
			System.out.print("both the arrays are same");
		}
		
		sc.close();
		
		
	}

