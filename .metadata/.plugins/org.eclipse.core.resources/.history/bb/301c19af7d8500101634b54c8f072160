package apr11__18_collection;

import java.util.ArrayList;
import java.util.Collection;
import java.util.List;

public class A16_A_list_methods {

	public static void main(String[] args) {
		// TODO Auto-generated method stub

		List<String> c1 = new ArrayList<>();// upcasting

//		Add value at perticular index
		
		c1.add(0,"DJ");
		c1.add(3,"Vaishnavi");
		c1.add(1,"Harsha");
		System.out.println(c1);

//		addAll method

		Collection<String> c2 = new ArrayList<>();
		c2.addAll(c1);
		System.out.println(c2);
		c2.add("Yogesh");
		System.out.println(c2);

//		contains method		

		boolean b1 = c2.contains("vishal");
		System.out.println(b1);
		boolean b2 = c2.containsAll(c1);
		System.out.println(b2);
		boolean b3 = c1.containsAll(c2);
		System.out.println(b3);

//		remove

		c2.remove("Yogesh");
		c2.add("Sarita");
		System.out.println(c2);

//		removeAll

		c2.add("Yogesh");
		c2.removeAll(c1);
		System.out.println(c2);

//	    isEmpty

		boolean b4 = c2.isEmpty();
		System.out.println(" " + b4);

//		clear

		c2.clear();
		System.out.println(c2);
		boolean b8 = c2.isEmpty();
		System.out.println(" " + b8);

//		equals

		boolean b5 = c2.equals(c1);
		System.out.println(b5);
			
//	     size

		int d = c1.size();
		System.out.println(d);

	}

}
