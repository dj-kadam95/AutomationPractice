package assignments_072_90;

import java.util.Arrays;
import java.util.Scanner;

public class Assignment_79 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub

//		WAP to check if two arrays are equals to each other at run time
		
		Scanner sc = new Scanner(System.in);
		
		System.out.println("enter array size");
		int length = sc.nextInt();
		
		String[] str1 =new String[length];
		String[] str2 =new String[str1.length];
		
		int j=length-1;
		
		for(int i=0; j=(length-1); i<length; i++ j--) {
			
			System.out.print("string value str1 at "+i+" :");
			str1[i] = sc.next();
			
			str2[i] = str1[i];
		     
		}	
		
		String s1 =Arrays.toString(str1);
		String s2 =Arrays.toString(str2);
		
		System.out.println("\nstr1 : "+s1);
		System.out.println("\nstr2 : "+s2);
		
		sc.close();
	
	}

}
